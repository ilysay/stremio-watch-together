<Project Sdk="Microsoft.NET.Sdk">
  <!-- .NET Framework 4.8 est intégré à Windows 10/11 : l'exe n'a besoin de rien d'autre. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>StremioWT</AssemblyName>
    <RootNamespace>StremioWT</RootNamespace>
    <Prefer32Bit>false</Prefer32Bit>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Product>Stremio Watch Together</Product>
    <AssemblyTitle>Stremio Watch Together</AssemblyTitle>
    <Description>Watch Stremio with friends, perfectly in sync. Open source (MIT): https://github.com/ilysay/stremio-watch-together</Description>
    <Company>ilyasb2</Company>
    <Authors>ilyasb2</Authors>
    <Copyright>Copyright (c) 2026 ilyasb2, MIT license</Copyright>
    <RepositoryUrl>https://github.com/ilysay/stremio-watch-together</RepositoryUrl>
    <NeutralLanguage>en</NeutralLanguage>
    <Version>3.5.11</Version>
    <ApplicationIcon>assets\app.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <EmbeddedResource Include="Stremio\inject.js" LogicalName="inject.js" />
    <EmbeddedResource Include="assets\logo.png" LogicalName="logo.png" />
    <EmbeddedResource Include="assets\histo.png" LogicalName="histo.png" />
    <EmbeddedResource Include="assets\histo.ico" LogicalName="histo.ico" />
    <InternalsVisibleTo Include="StremioWT.Tests" />
  </ItemGroup>
</Project>
